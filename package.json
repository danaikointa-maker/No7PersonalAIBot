{
  "name": "no7-personal-ai-bot",
  "version": "2.2.0",
  "description": "No7 Personal AI Bot — one codebase for Mobile + PC (PWA + Electron + Capacitor), Thai-first voice AI companion with role modes, multi-step agent and permission gate",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "npm run build && node server/server.js",
    "server": "node server/server.js",
    "desktop": "npm run build && electron desktop/main.js",
    "desktop:dev": "electron desktop/main.js --dev",
    "desktop:dist": "npm run build && electron-builder",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:open:android": "npx cap open android",
    "test": "node --test tests/*.test.js",
    "check": "node tools/check.js",
    "test:browser": "node tests/smoke.browser.mjs",
    "perf": "node tools/perf.js"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  },
  "build": {
    "appId": "ai.no7.personalaibot",
    "productName": "No7 AI",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danaikointa-maker",
        "repo": "No7PersonalAIBot"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
